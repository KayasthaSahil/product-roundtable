{
  "type": "object",
  "required": [
    "verdicts"
  ],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "verdict",
          "verifier",
          "method"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^SUT-(PMV|PMS|CMP|ARC|FE|BE|AI|MED|VIS|UX|XAI|DOC|QA|CPE|RED|VER)-\\d{3}$"
          },
          "verdict": {
            "enum": [
              "verified",
              "partially-verified",
              "unverified",
              "reclassified",
              "duplicate"
            ]
          },
          "verifier": {
            "type": "string",
            "pattern": "^(CHR|PMV|PMS|CMP|ARC|FE|BE|AI|MED|VIS|UX|XAI|DOC|QA|CPE|RED|VER|SCR)$"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array"
          },
          "notes": {
            "type": "string"
          },
          "duplicate_of": {
            "type": "string"
          },
          "reclassified": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "Critical",
                  "High",
                  "Medium",
                  "Low",
                  "Opportunity"
                ]
              },
              "category": {
                "enum": [
                  "Bug / Defect",
                  "Architectural Problem",
                  "UX / Usability Problem",
                  "Visual Design Problem",
                  "Performance / Cost Problem",
                  "Security / Reliability Risk",
                  "Missing Capability",
                  "Redundancy / Complexity",
                  "Documentation Problem",
                  "Product Strategy Opportunity"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification"
}