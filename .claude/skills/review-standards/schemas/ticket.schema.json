{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementation-planning-ticket",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "priority",
    "workstream",
    "findings",
    "decisions",
    "objective",
    "current_behavior",
    "expected_behavior",
    "rationale",
    "scope",
    "implementation_plan",
    "source_inspection",
    "implementation_locations",
    "dependencies",
    "owner_role",
    "effort",
    "acceptance_criteria",
    "verification_plan",
    "rollback",
    "handoff_requirements",
    "owner_approval",
    "quality_review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "AWAITING_OWNER_APPROVAL",
        "APPROVED",
        "BLOCKED",
        "DEFERRED",
        "REJECTED"
      ],
      "description": "Planning lifecycle only. APPROVED means owner-approved as part of the plan; no status in this schema represents implementation progress or completion."
    },
    "priority": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "workstream": {
      "type": "string",
      "pattern": "^WS-\\d{2}$"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SUT-[A-Z]{2,3}-\\d{3}$"
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^DEC-\\d{3}$"
      },
      "uniqueItems": true
    },
    "disputes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DBT-\\d{3}$"
      },
      "uniqueItems": true
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "current_behavior": {
      "type": "string",
      "minLength": 20
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 20
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "scope": {
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "source_inspection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "status"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 8
          },
          "status": {
            "enum": [
              "verified",
              "to_verify"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "implementation_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "candidate_to_verify"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TASK-\\d{3}|WS-\\d{2}|DEC-\\d{3})$"
      },
      "uniqueItems": true
    },
    "owner_role": {
      "type": "string",
      "pattern": "^(CHR|PMV|PMS|CMP|ARC|FE|BE|AI|MED|VIS|UX|XAI|DOC|QA|CPE|RED|VER|SCR)$",
      "description": "Proposed planning owner role for this ticket. This is not an implementation assignment."
    },
    "effort": {
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "string",
      "minLength": 10
    },
    "owner_approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Owner approval of inclusion in the plan only; never an implementation authorisation.",
      "additionalProperties": false
    },
    "blocker": {
      "type": "string"
    },
    "revisit_trigger": {
      "type": "string"
    },
    "readiness": {
      "type": "object",
      "required": [
        "verdict",
        "conditions",
        "satisfied_conditions",
        "open_conditions"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "Go",
            "Go with conditions",
            "Hold"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "satisfied_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "open_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "assessed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessed_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "implementation_plan": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 8
      },
      "description": "Ordered proposed steps for a future, separately authorised implementer. The committee does not execute these steps."
    },
    "verification_plan": {
      "type": "object",
      "required": [
        "test_scenarios",
        "required_checks"
      ],
      "properties": {
        "test_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "test_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Test scenarios and checks a future implementation process should perform. These are plans, not test results.",
      "additionalProperties": false
    },
    "handoff_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      },
      "description": "Evidence a future, separately authorised implementation process should provide. These are requirements, not recorded results.",
      "uniqueItems": true
    },
    "quality_review": {
      "type": "object",
      "required": [
        "verdict",
        "reviewed_by",
        "reviewed_at",
        "checks",
        "issues"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "NOT_REVIEWED",
            "PASS",
            "REVISE",
            "BLOCKED"
          ]
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "checks": {
          "type": "object",
          "required": [
            "traceability",
            "behavior_clarity",
            "scope_decomposition",
            "source_grounding",
            "dependency_integrity",
            "acceptance_criteria",
            "verification_plan",
            "rollback_and_handoff",
            "status_and_gate_alignment"
          ],
          "properties": {
            "traceability": {
              "type": "boolean"
            },
            "behavior_clarity": {
              "type": "boolean"
            },
            "scope_decomposition": {
              "type": "boolean"
            },
            "source_grounding": {
              "type": "boolean"
            },
            "dependency_integrity": {
              "type": "boolean"
            },
            "acceptance_criteria": {
              "type": "boolean"
            },
            "verification_plan": {
              "type": "boolean"
            },
            "rollback_and_handoff": {
              "type": "boolean"
            },
            "status_and_gate_alignment": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Chair-recorded planning quality review. PASS is required before a ticket can enter AWAITING_OWNER_APPROVAL or APPROVED. This is not implementation verification."
    }
  },
  "description": "Planning artifact created by the Review Committee for future, separately authorised implementation. This record tracks planning approval only; it does not track implementation progress or completion.",
  "additionalProperties": false
}
