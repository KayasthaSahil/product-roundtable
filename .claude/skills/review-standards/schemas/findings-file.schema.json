{
  "type": "object",
  "required": [
    "role",
    "cycle",
    "findings"
  ],
  "properties": {
    "role": {
      "type": "string",
      "pattern": "^(CHR|PMV|PMS|CMP|ARC|FE|BE|AI|MED|VIS|UX|XAI|DOC|QA|CPE|RED|VER|SCR)$"
    },
    "cycle": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings-file"
}