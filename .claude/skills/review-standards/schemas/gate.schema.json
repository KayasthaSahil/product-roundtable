{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workstream",
          "verdict",
          "risk",
          "effort",
          "regression_risk"
        ],
        "properties": {
          "workstream": {
            "type": "string",
            "pattern": "^WS-\\d{2}$"
          },
          "verdict": {
            "enum": [
              "Go",
              "Go with conditions",
              "Hold"
            ]
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "cost_impact": {
            "type": "string"
          },
          "operational_impact": {
            "type": "string"
          },
          "regression_risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "premortem": {
            "type": "string"
          },
          "assessed_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate"
}