{
  "type": "object",
  "required": [
    "decisions"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "findings",
          "disposition",
          "rationale",
          "owner_role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "disputes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "enum": [
              "Accepted",
              "Accepted with modifications",
              "Rejected",
              "Deferred",
              "Requires experiment",
              "Requires additional evidence",
              "Merged"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "pattern": "^(CHR|PMV|PMS|CMP|ARC|FE|BE|AI|MED|VIS|UX|XAI|DOC|QA|CPE|RED|VER|SCR)$"
          },
          "decided_by": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tradeoffs": {
            "type": "string"
          },
          "dissent": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "point"
              ]
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strategic": {
            "type": "boolean"
          },
          "modifications": {
            "type": "string"
          },
          "revisit_trigger": {
            "type": "string"
          },
          "experiment": {
            "type": "string"
          },
          "merged_into": {
            "type": "string"
          },
          "workstream": {
            "type": "string"
          },
          "reconsidered": {
            "type": "boolean"
          },
          "implementation_required": {
            "type": "boolean"
          },
          "ticket_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-\\d{3}$"
            }
          },
          "no_ticket_reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decisions"
}
